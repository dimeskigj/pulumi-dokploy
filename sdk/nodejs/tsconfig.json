{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "application.ts",
        "backup.ts",
        "compose.ts",
        "config/index.ts",
        "config/vars.ts",
        "destination.ts",
        "domain.ts",
        "environment.ts",
        "index.ts",
        "mariaDB.ts",
        "mongoDB.ts",
        "mount.ts",
        "mySQL.ts",
        "postgres.ts",
        "project.ts",
        "projectTag.ts",
        "provider.ts",
        "redis.ts",
        "registry.ts",
        "sshkey.ts",
        "tag.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts",
        "volumeBackup.ts"
    ]
}
