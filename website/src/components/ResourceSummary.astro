---
type RelatedResource = { label: string; href: string };
const { name, description, lifecycle, related = [] } = Astro.props as {
  name: string;
  description: string;
  lifecycle: string;
  related?: RelatedResource[];
};
---

<section class="resource-summary" aria-labelledby={`${name}-summary`}>
  <p class="eyebrow">Resource</p>
  <h2 id={`${name}-summary`}>{name}</h2>
  <p>{description}</p>
  <p><strong>Lifecycle:</strong> {lifecycle}</p>
  {related.length > 0 && <nav aria-label={`Related resources for ${name}`}>
    <h3>Related resources</h3>
    <ul>{related.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
  </nav>}
</section>
